<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl">

    <LinearLayout
        android:id="@+id/cart_item_name_price_container"
        android:layout_width="@dimen/_45sdp"
        android:layout_height="@dimen/_55sdp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ir.ac.kntu.Technical.CustomView.TextViewPlus
            android:id="@+id/cart_item_price_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:maxLines="1"
            android:text=""
            android:textColor="@android:color/white"
            android:textSize="12sp" />

        <ir.ac.kntu.Technical.CustomView.TextViewPlus
            android:id="@+id/cart_item_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:text=""
            android:textColor="@android:color/white"
            android:textSize="13sp" />

    </LinearLayout>

    <ir.ac.kntu.Technical.CustomView.TextViewPlus
        android:id="@+id/cart_item_name_counter"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:background="@android:color/white"
        android:gravity="center_vertical|start"
        android:paddingStart="@dimen/_28sdp"
        android:textColor="#3C3C3C"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/cart_item_name_price_container"
        app:layout_constraintTop_toTopOf="parent" />

    <ir.ac.kntu.Technical.CustomView.TextViewPlus
        android:id="@+id/cart_item_name_counter_symbol"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:background="@android:color/white"
        android:gravity="center"
        android:paddingStart="@dimen/_2sdp"
        android:paddingEnd="@dimen/_2sdp"
        android:textColor="#3C3C3C"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/cart_item_name_counter"
        app:layout_constraintTop_toTopOf="parent" />

    <ir.ac.kntu.Technical.CustomView.TextViewPlus
        android:id="@+id/cart_item_name_value"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/white"
        android:gravity="center_vertical|start"
        android:paddingEnd="@dimen/_2sdp"
        android:textColor="#3C3C3C"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/cart_item_name_counter_symbol"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>