<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    android:layoutDirection="rtl"
    tools:context=".Fragment.Fragment_Forget_Reset_Password">

    <VideoView
        android:id="@+id/fragment_forget_reset_password_videoview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ir.ac.kntu.Technical.CustomView.EditTextPlus
        android:id="@+id/fragment_forget_reset_password_password"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="48dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="48dp"
        android:background="@drawable/dr_user_pass"
        android:drawableStart="@drawable/ic_key"
        android:drawablePadding="16dp"
        android:gravity="start|center_vertical"
        android:hint="@string/new_password"
        android:inputType="text"
        android:maxLength="30"
        android:maxLines="1"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:textColor="@android:color/black"
        android:textColorHint="#46000000"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ir.ac.kntu.Technical.CustomView.EditTextPlus
        android:id="@+id/fragment_forget_reset_password_password_confirmed"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/dr_user_pass"
        android:drawableStart="@drawable/ic_key"
        android:drawablePadding="16dp"
        android:gravity="start|center_vertical"
        android:hint="@string/new_password_confirmed"
        android:inputType="text"
        android:maxLength="30"
        android:maxLines="1"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:textColor="@android:color/black"
        android:textColorHint="#46000000"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="@+id/fragment_forget_reset_password_password"
        app:layout_constraintStart_toStartOf="@+id/fragment_forget_reset_password_password"
        app:layout_constraintTop_toBottomOf="@+id/fragment_forget_reset_password_password" />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/fragment_forget_reset_password_enter"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="48dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/dr_login_orange_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fragment_forget_reset_password_password_confirmed">

        <ProgressBar
            android:id="@+id/fragment_forget_reset_password_progressbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/fragment_forget_reset_password_text"
            app:layout_constraintTop_toTopOf="parent" />

        <ir.ac.kntu.Technical.CustomView.TextViewPlus
            android:id="@+id/fragment_forget_reset_password_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:text="@string/reset_password"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:bold="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>