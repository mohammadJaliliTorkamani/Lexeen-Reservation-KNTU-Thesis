<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="200dp"
    android:layout_gravity="center"
    android:background="@drawable/dr_round_corner_dialog"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="200dp">

        <ir.ac.kntu.Technical.CustomView.TextViewPlus
            android:id="@+id/dialog_bi_option_title"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/dr_round_corner_colorful_top_title"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ir.ac.kntu.Technical.CustomView.TextViewPlus
            android:id="@+id/dialog_bi_option_message"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:gravity="right|center_vertical"
            android:maxLines="3"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="2dp"
            android:textColor="@color/dark_gray"
            android:textSize="@dimen/_16sdp"
            app:layout_constraintBottom_toTopOf="@id/dialog_bi_option_options_container"
            app:layout_constraintTop_toBottomOf="@id/dialog_bi_option_title" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/dialog_bi_option_options_container"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <ir.ac.kntu.Technical.CustomView.TextViewPlus
                android:id="@+id/dialog_bi_option_option1_tv"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginRight="0.5dp"
                android:background="@drawable/dr_round_corner_colorful_left_option"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/dialog_bi_option_option2_tv" />

            <ir.ac.kntu.Technical.CustomView.TextViewPlus
                android:id="@+id/dialog_bi_option_option2_tv"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="0.5dp"
                android:background="@drawable/dr_round_corner_colorful_right_option"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                app:layout_constraintLeft_toRightOf="@+id/dialog_bi_option_option1_tv"
                app:layout_constraintRight_toRightOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>