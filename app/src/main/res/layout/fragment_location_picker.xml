<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:mapbox="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_background_color"
    android:layoutDirection="ltr"
    android:orientation="vertical"
    android:weightSum="100"
    tools:context=".Fragment.Fragment_LocationPicker">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/location_picker_select_place_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/btm_bar_height"
        android:layout_gravity="bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ProgressBar
            android:id="@+id/location_picker_select_place_pb"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:visibility="gone" />

        <ir.ac.kntu.Technical.CustomView.TextViewPlus
            android:id="@+id/location_picker_select_place_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:text="@string/select_place"
            android:textColor="@android:color/white"
            android:textSize="21sp"
            android:visibility="visible" />


    </androidx.coordinatorlayout.widget.CoordinatorLayout>


    <ir.map.sdk_map.maps.MapView
        android:id="@+id/location_picker_mapview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/location_picker_select_place_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        mapbox:mapbox_cameraZoomMax="20"
        mapbox:mapbox_cameraZoomMin="1" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/black"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/location_picker_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:scaleX="-1"
            android:src="@drawable/ic_back"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ir.ac.kntu.Technical.CustomView.TextViewPlus
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/postal_address"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="@id/location_picker_back"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@id/location_picker_back" />

        <LinearLayout
            android:id="@+id/location_picker_top_address_detail_frame"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="18dp"
            android:orientation="horizontal"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/location_picker_back">

            <ir.ac.kntu.Technical.CustomView.EditTextPlus
                android:id="@+id/location_picker_floor_and_unit"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginRight="4dp"
                android:layout_weight="1"
                android:background="@drawable/dr_address_detail"
                android:gravity="right|center_vertical"
                android:hint="@string/floor_and_unit"
                android:inputType="text"
                android:maxLength="6"
                android:maxLines="1"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:textColor="@android:color/black"
                android:textColorHint="@color/gray_shadow"
                android:textSize="18sp" />

            <ir.ac.kntu.Technical.CustomView.EditTextPlus
                android:id="@+id/location_picker_block_no"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="4dp"
                android:layout_weight="1"
                android:background="@drawable/dr_address_detail"
                android:gravity="right|center_vertical"
                android:hint="@string/block_num"
                android:inputType="text"
                android:maxLength="6"
                android:maxLines="1"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:textColor="@android:color/black"
                android:textColorHint="@color/gray_shadow"
                android:textSize="18sp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/location_picker_my_location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:padding="16dp"
        android:src="@android:drawable/ic_dialog_map"
        app:layout_constraintBottom_toTopOf="@id/location_picker_select_place_container"
        app:layout_constraintRight_toRightOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>