<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:layout_height="match_parent"
    android:background="@color/neutral_background_color">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/fragment_scanner_content_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toTopOf="@+id/fragment_scanner_scan" />

        <ir.ac.kntu.Technical.CustomView.ButtonPlus
            android:id="@+id/fragment_scanner_scan"
            android:layout_width="0dp"
            android:layout_height="@dimen/btm_bar_height"
            android:foreground="?android:attr/selectableItemBackground"
            android:text="@string/scan"
            android:textColor="@android:color/white"
            android:textSize="@dimen/home_font_textview"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>