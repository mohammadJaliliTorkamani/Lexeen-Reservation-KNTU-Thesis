<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_lading_page_item"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:layout_margin="4dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/item_lading_page_scan_item"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white"
        android:foreground="?android:attr/selectableItemBackground"
        android:visibility="gone">

        <ImageView
            android:id="@+id/item_lading_page_scan_image"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/ic_scan"
            app:layout_constraintBottom_toTopOf="@+id/item_lading_page_scan_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ir.ac.kntu.Technical.CustomView.TextViewPlus
            android:id="@+id/item_lading_page_scan_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/scan"
            android:textColor="@android:color/black"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/item_lading_page_scan_image"
            app:layout_constraintStart_toStartOf="@+id/item_lading_page_scan_image"
            app:layout_constraintTop_toBottomOf="@id/item_lading_page_scan_image" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/item_lading_page_non_scan_item"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:foreground="?android:attr/selectableItemBackground"
        android:visibility="visible">

        <ImageView
            android:id="@+id/item_lading_page_image"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_lexin_icon"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/item_lading_page_others_content_continer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/dr_landing_page_item_gradient_active">

            <ImageView
                android:id="@+id/item_lading_page_location_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="19dp"
                android:layout_marginBottom="16dp"
                android:src="@drawable/location_marker"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <ir.ac.kntu.Technical.CustomView.TextViewPlus
                android:id="@+id/item_lading_page_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:textColor="@android:color/white"
                android:textSize="9sp"
                app:layout_constraintBottom_toTopOf="@+id/item_lading_page_address"
                app:layout_constraintStart_toStartOf="@+id/item_lading_page_location_icon" />

            <ir.ac.kntu.Technical.CustomView.TextViewPlus
                android:id="@+id/item_lading_page_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                app:bold="true"
                app:layout_constraintBottom_toTopOf="@+id/item_lading_page_type"
                app:layout_constraintStart_toStartOf="@+id/item_lading_page_location_icon" />

            <ir.ac.kntu.Technical.CustomView.TextViewPlus
                android:id="@+id/item_lading_page_address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@android:color/white"
                android:textSize="9sp"
                app:bold="true"
                app:layout_constraintBottom_toBottomOf="@id/item_lading_page_location_icon"
                app:layout_constraintStart_toEndOf="@id/item_lading_page_location_icon"
                app:layout_constraintTop_toTopOf="@id/item_lading_page_location_icon" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.cardview.widget.CardView>