<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/landing_page_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/landing_page_background_color"
    android:paddingStart="10dp"
    android:paddingTop="16dp"
    android:clickable="true"
    android:focusable="true"
    android:fitsSystemWindows="false"
    android:paddingEnd="10dp"
    tools:context=".Fragment.Fragment_LandingPage">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_marginTop="48dp"
        android:layout_height="match_parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/landing_page_toolbar"
            android:layout_width="match_parent"
            android:layout_height="66dp"
            app:contentInsetEnd="0dp"
            app:contentInsetStart="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.coordinatorlayout.widget.CoordinatorLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ir.ac.kntu.Technical.CustomView.TextViewPlus
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="@string/app_name_lowercase"
                    android:textColor="@android:color/white"
                    android:textSize="50sp"
                    app:customFont="latin/Beattingvile.otf" />

                <ImageView
                    android:id="@+id/landing_page_toolbar_expand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="right|center_vertical"
                    android:padding="16dp"
                    android:src="@drawable/ic_menu_bar_right" />

            </androidx.coordinatorlayout.widget.CoordinatorLayout>
        </androidx.appcompat.widget.Toolbar>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/landing_page_search_search_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/landing_page_toolbar">


            <ImageView
                android:id="@+id/landing_page_filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:padding="12dp"
                android:src="@drawable/ic_menu_bar_right"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ir.ac.kntu.Technical.CustomView.EditTextPlus
                android:id="@+id/landing_page_search_et"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginLeft="8dp"
                android:background="@drawable/dr_oval_search_landing_page"
                android:drawableRight="@drawable/ic_search_landing_page"
                android:drawablePadding="16dp"
                android:gravity="right|center_vertical"
                android:hint="@string/restaurant_name"
                android:maxLines="1"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@id/landing_page_filter"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <ir.ac.kntu.Technical.CustomView.TextViewPlus
            android:id="@+id/landing_page_restaurants_of"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginRight="20dp"
            android:gravity="center"
            android:text="@string/restaurants_of"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:visibility="gone"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/landing_page_search_search_bar" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/landing_page_restaurant_classes_filter_rv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/landing_page_restaurants_of" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/landing_page_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="48dp"
            android:layout_marginTop="16dp"
            android:overScrollMode="never"
            android:scrollbars="none"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/landing_page_restaurant_classes_filter_rv" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <include
        layout="@layout/layout_navigation_drawer"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />
</androidx.drawerlayout.widget.DrawerLayout>